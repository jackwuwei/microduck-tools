+/// Per-robot zero trims, in encoder counts, indexed as [`JOINT_IDS`].
+///
+/// Replace the neutral defaults with this robot's measured zero minus 2048.
+/// Keep the startup homing offsets unchanged; reads subtract and goals add trims.
+pub const ZERO_TRIM_COUNTS: [i32; NUM_JOINTS] = [0; NUM_JOINTS];
+
+/// Convert an encoder-count trim to radians.
+pub fn zero_trim(joint: usize) -> f64 {
+    ZERO_TRIM_COUNTS[joint] as f64 * 2.0 * std::f64::consts::PI / 4096.0
+}
