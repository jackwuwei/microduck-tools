+/// This board uses the MicroDuck IMU bus protocol v1.2 (2026-09-28), page 5:
+/// gyro degrees/second = signed count / 16.4. Using the ST chip's raw sensitivity
+/// here under-reports this board's transmitted rate by 3.484 times.
+const GYRO_RAD_PER_LSB: f64 = std::f64::consts::PI / (180.0 * 16.4);
 
