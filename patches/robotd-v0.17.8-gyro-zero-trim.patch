+    /// Pin the board protocol's physical units independently of the decoder constant.
+    /// This prevents a chip sensitivity from silently replacing the bus scale again.
+    #[test]
+    fn protocol_v1_2_gyro_counts_decode_to_radians_per_second() {
+        let mut d = SflpDecoder::new([1.0, 0.0, 0.0, 0.0]);
+        let mut block = [0u8; IMU_BLOCK_LEN];
+        for (axis, count) in [1640i16, -820, 328].iter().enumerate() {
+            block[2 * axis..2 * axis + 2].copy_from_slice(&count.to_le_bytes());
+        }
+        d.decode(&block);
+        d.decode(&block);
+        let out = d.decode(&block);
+        for (actual, degrees_per_second) in out.gyro.iter().zip([100.0_f64, -50.0, 20.0]) {
+            assert!((actual - degrees_per_second.to_radians()).abs() < 1e-9);
+        }
+    }
